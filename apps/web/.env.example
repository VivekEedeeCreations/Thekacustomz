# apps/web/.env.example
# Copy to apps/web/.env and fill in real values. Never commit apps/web/.env.
#
# Only VITE_* variables are exposed to the browser bundle.
# NEVER put the Supabase service-role / secret key in this file.

# Supabase project (Project Settings → API in the Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# OPTIONAL. Base URL of the backend REST API (apps/api). No feature uses the API yet,
# so leave this unset when deploying just the web app.
# VITE_API_URL=http://localhost:4000
