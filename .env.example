# ─────────────────────────────────────────────────────────────────────────────
# Root .env.example — reference for ALL environment variables in the monorepo.
#
# This file is documentation only. Each app reads its own env file:
#   - Frontend: apps/web/.env   (copy from apps/web/.env.example)
#   - Backend:  apps/api/.env   (copy from apps/api/.env.example)
#
# SECURITY: Never put the Supabase service-role / secret key in apps/web.
#           Only VITE_* values are shipped to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Shared: Supabase project ----
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# ---- Frontend only (safe to expose to the browser) ----
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# VITE_API_URL=http://localhost:4000

# ---- Backend only (server-only, NEVER exposed to the browser) ----
PORT=4000
NODE_ENV=development
API_CORS_ORIGIN=http://localhost:5173
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
